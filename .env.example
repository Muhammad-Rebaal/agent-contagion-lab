# Copy to .env and set whichever provider you plan to run.
# Leave unused keys blank.

# Core providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# Open-source / router endpoints
OPENROUTER_API_KEY=
COHERE_API_KEY=
NVIDIA_API_KEY=
AION_API_KEY=
SILICONFLOW_API_KEY=
LLM7_API_KEY=
MODELSCOPE_API_KEY=
GONKA_API_KEY=
ORCAROUTER_API_KEY=
HF_TOKEN=

# Cloudflare
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=

# Custom OpenAI-compatible endpoint
LLM_API_KEY=
LLM_BASE_URL=

# LangSmith tracing (optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=agent-contagion-lab
